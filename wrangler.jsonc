{
  // ブログ本体は静的アセットだけを配信する Worker（ADR-0005）。Worker のコードは書かない。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "astro-blog",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    // /articles/<id>.html を /articles/<id> で返す（ADR-0006）。既定値だが、意図を残すために書く。
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
