# 旧ブログの URL と、無くしたページのリダイレクト（ADR-0006・docs/specs/blog-replace.md §4）。
# Cloudflare Workers の静的アセットが読む。公開済みの URL を変えたら、ここに 301 を足す。

# 記事の一覧の 1 ページ目は /
/articles              /                 301
/articles/             /                 301
/articles/page/1       /                 301

# タグは廃止した
/articles/tags/*       /                 301

# ノート・寄付・認証・プレビューは移していない
/notes                 /                 301
/notes/*               /                 301
/donation              /                 301
/auth/*                /                 301
/preview/*             /                 301
