---
// カテゴリ別の記事（/articles/categories/<id>）。
import type { GetStaticPaths } from "astro";

import PostList from "../../../components/PostList.astro";
import Base from "../../../layouts/Base.astro";
import { getCategories, getPosts, type Category } from "../../../lib/posts";

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((category) => ({ params: { id: category.id }, props: { category } }));
}) satisfies GetStaticPaths;

interface Props {
  category: Category;
}

const { category } = Astro.props;
const posts = (await getPosts()).filter((post) => post.data.category.id === category.id);
const { name, description } = category.data;
---

<Base title={name} description={description ?? `${name}の記事`}>
  <header class="heading">
    <p class="kind">カテゴリ</p>
    <h1>{name}</h1>
    {description && <p class="description">{description}</p>}
  </header>
  <PostList posts={posts} />
</Base>

<style>
  .heading {
    margin-bottom: 3.5rem;
  }

  .kind {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  h1 {
    margin: 0.2rem 0 0.6rem;
    font-size: 2rem;
  }

  .description {
    margin: 0;
    color: var(--muted);
  }
</style>
