---
// 記事: 投稿の見出し、目次、本文、前後の記事（docs/specs/design.md §4・§5）。
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import "../../styles/prose.css";
import CategoryMark from "../../components/CategoryMark.astro";
import Toc from "../../components/Toc.astro";
import Base from "../../layouts/Base.astro";
import { neighbors } from "../../lib/board";
import { formatBbsDate, toIsoDate } from "../../lib/format";
import {
  articlePath,
  categoryPath,
  getCategory,
  getPostNumbers,
  getPosts,
  type Post,
} from "../../lib/posts";
import { site } from "../../site.config";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = await getCategory(post);
const number = (await getPostNumbers()).get(post.id);
const { older, newer } = neighbors(await getPosts(), post.id);
const { pubDate, updatedDate } = post.data;
---

<Base title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <h1 style={`view-transition-name: post-${post.id}`}>
        <span class="no">[{number === undefined ? "下書き" : `No.${number}`}]</span>
        {post.data.title}
      </h1>
      <p class="meta">
        <span>投稿者：<a href="/about" rel="author">{site.author.name}</a></span>
        <span>投稿日：<time datetime={toIsoDate(pubDate)}>{formatBbsDate(pubDate)}</time></span>
        {
          updatedDate && (
            <span>
              更新日：<time datetime={toIsoDate(updatedDate)}>{formatBbsDate(updatedDate)}</time>
            </span>
          )
        }
        <span>
          カテゴリ：<CategoryMark category={category} /><a href={categoryPath(category.id)}>{category.data.name}</a>
        </span>
      </p>
    </header>

    <div class="body">
      <Toc headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <hr />
  <nav class="neighbors" aria-label="前後の書き込み">
    {older ? <a href={articlePath(older.id)} rel="prev">◀ 前の書き込み</a> : <span>◀ 前の書き込み</span>}
    <span aria-hidden="true">｜</span>
    <a href="/">掲示板に戻る</a>
    <span aria-hidden="true">｜</span>
    {newer ? <a href={articlePath(newer.id)} rel="next">次の書き込み ▶</a> : <span>次の書き込み ▶</span>}
  </nav>
</Base>

<style>
  .post-header {
    border: 2px var(--bevel-out) var(--frame-hi);
    padding: 0.4em 0.8em;
    margin: 0 0 1.5em;
  }

  .post-header h1 {
    font-size: 1.6em;
    margin: 0.2em 0;
  }

  .no {
    font-family: var(--mono);
    font-size: 0.7em;
    margin-right: 0.3em;
    vertical-align: 0.1em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5em;
    margin: 0;
    font-family: var(--mono);
    font-size: 0.85em;
  }

  /* PC では目次を本文の右に置く。 */
  @media (width >= 72em) {
    .body {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) 15em;
      gap: 2em;
      align-items: start;
    }

    .body > :global(.toc) {
      order: 2;
      position: sticky;
      top: 1em;
      max-height: calc(100vh - 2em);
      overflow-y: auto;
    }
  }

  .neighbors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3em 0.8em;
  }

  .neighbors span:not([aria-hidden]) {
    color: var(--quiet);
  }
</style>
