---
// 記事: 見出し（カテゴリ・日付・題名）、目次、本文、前後の記事（docs/specs/design.md §4・§5）。
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import "../../styles/prose.css";
import CategoryLabel from "../../components/CategoryLabel.astro";
import Toc from "../../components/Toc.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, toIsoDate } from "../../lib/format";
import { neighbors } from "../../lib/listing";
import { articlePath, getCategory, getPosts, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = await getCategory(post);
const { older, newer } = neighbors(await getPosts(), post.id);
const { title, description, pubDate, updatedDate, draft } = post.data;
---

<Base title={title} description={description} wide>
  <article>
    <header class="heading">
      <p class="meta">
        <CategoryLabel category={category} />
        <time datetime={toIsoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              更新 <time datetime={toIsoDate(updatedDate)}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        {draft && <span class="draft">下書き</span>}
      </p>
      <h1 style={`view-transition-name: post-${post.id}`}>{title}</h1>
    </header>

    <div class="body">
      <Toc headings={headings} />
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    (older || newer) && (
      <nav class="neighbors" aria-label="前後の記事">
        {older ? (
          <a class="older" href={articlePath(older.id)} rel="prev">
            <span class="label">前の記事</span>
            <span class="neighbor-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="newer" href={articlePath(newer.id)} rel="next">
            <span class="label">次の記事</span>
            <span class="neighbor-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  .heading {
    max-width: var(--measure);
    margin-bottom: 3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
    margin: 0 0 0.75rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .draft {
    padding: 0 0.5em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.45;
  }

  /* PC では目次を本文の右に置く。 */
  @media (width >= 64rem) {
    .body {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) 14rem;
      justify-content: space-between;
      gap: 3rem;
      align-items: start;
    }

    .body > :global(.toc) {
      order: 2;
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }
  }

  .neighbors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--measure);
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .neighbors a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }

  .label {
    font-size: 0.82rem;
    color: var(--muted);
  }

  .neighbor-title {
    color: var(--strong);
    font-weight: 600;
    line-height: 1.7;
    word-break: auto-phrase;
  }

  .neighbors a:hover .neighbor-title {
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2rem);
  }

  @media (width < 36rem) {
    .neighbors {
      grid-template-columns: 1fr;
    }

    .newer {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
