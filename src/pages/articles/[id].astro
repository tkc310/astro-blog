---
// 記事: 見出し（カテゴリ・日付・題名）、目次、本文、前後の記事（docs/specs/design.md §4・§5）。
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import "../../styles/prose.css";
import CategoryLabel from "../../components/CategoryLabel.astro";
import Toc from "../../components/Toc.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, toIsoDate } from "../../lib/format";
import { neighbors } from "../../lib/listing";
import { articlePath, getCategory, getPosts, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = await getCategory(post);
const { older, newer } = neighbors(await getPosts(), post.id);
const { title, description, pubDate, updatedDate, draft } = post.data;
---

<Base title={title} description={description}>
  <article>
    <header class="heading">
      <p class="meta">
        <CategoryLabel category={category} />
        <time datetime={toIsoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              更新 <time datetime={toIsoDate(updatedDate)}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        {draft && <span class="draft">下書き</span>}
      </p>
      <h1 style={`view-transition-name: post-${post.id}`}>{title}</h1>
    </header>

    <div class="body">
      <div class="toc-rail">
        <Toc headings={headings} />
      </div>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    (older || newer) && (
      <nav class="neighbors" aria-label="前後の記事">
        {older ? (
          <a class="older" href={articlePath(older.id)} rel="prev">
            <span class="label">前の記事</span>
            <span class="neighbor-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="newer" href={articlePath(newer.id)} rel="next">
            <span class="label">次の記事</span>
            <span class="neighbor-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  .heading {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .draft {
    padding: 0 0.6em;
    border: 1px solid var(--faint);
    border-radius: 999px;
    font-size: var(--text-2xs);
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.55;
    /* 大きな文字では欧文の字間が開きすぎるので、本文より詰める。 */
    letter-spacing: 0.03em;
  }

  .body {
    position: relative;
  }

  /*
   * 広い画面では、目次を本文の列の外（右の余白）に置き、スクロールしても見えるようにする。
   * 本文の列の幅と位置は、ほかのページと同じまま。
   */
  @media (width >= 80rem) {
    .toc-rail {
      position: absolute;
      inset: 0 auto 0 calc(100% + var(--space-8));
      width: 13rem;
    }

    .toc-rail > :global(.toc) {
      position: sticky;
      top: var(--space-7);
      max-height: calc(100vh - var(--space-7) * 2);
      overflow-y: auto;
    }
  }

  .neighbors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    max-width: var(--measure);
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .neighbors a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }

  .label {
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .neighbor-title {
    color: var(--strong);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.8;
    word-break: auto-phrase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
    transition: text-decoration-color 0.2s;
  }

  .neighbors a:hover .neighbor-title {
    text-decoration-color: currentColor;
  }

  @media (width < 36rem) {
    .neighbors {
      grid-template-columns: 1fr;
    }

    .newer {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
