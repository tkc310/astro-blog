---
// 記事: 見出し（カテゴリ・日付・題名）、目次、本文、前後の記事（docs/specs/design.md §4・§5）。
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";

import "../../styles/prose.css";
import CategoryLabel from "../../components/CategoryLabel.astro";
import DraftLabel from "../../components/DraftLabel.astro";
import HeadingLink from "../../components/HeadingLink.astro";
import WithToc from "../../components/WithToc.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, toIsoDate } from "../../lib/format";
import { articleGraph } from "../../lib/jsonld";
import { neighbors } from "../../lib/listing";
import { articlePath, categoryPath, getCategory, getPosts, type Post } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = await getCategory(post);
const { older, newer } = neighbors(await getPosts(), post.id);
const { title, description, pubDate, updatedDate, draft } = post.data;
const graph = articleGraph({
  path: articlePath(post.id),
  title,
  description,
  pubDate,
  updatedDate,
  category: { name: category.data.name, path: categoryPath(category.id) },
  body: post.body ?? "",
});
---

<Base title={title} description={description} ogType="article" noindex={draft} graph={graph}>
  <article>
    <header class="heading">
      <p class="meta">
        <CategoryLabel category={category} />
        <time datetime={toIsoDate(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              更新 <time datetime={toIsoDate(updatedDate)}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        {draft && <DraftLabel />}
      </p>
      <h1 style={`view-transition-name: post-${post.id}`}>
        {title}
      </h1>
    </header>

    <WithToc headings={headings}>
      <div class="prose">
        <Content />
      </div>
    </WithToc>
  </article>
  <HeadingLink />

  {
    (older || newer) && (
      <nav class="neighbors" aria-label="前後の記事">
        {older ? (
          <a class="older" href={articlePath(older.id)} rel="prev">
            <span class="label">前の記事</span>
            <span class="neighbor-title">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="newer" href={articlePath(newer.id)} rel="next">
            <span class="label">次の記事</span>
            <span class="neighbor-title">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )
  }
</Base>

<style>
  .heading {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-5);
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.55;
    /* 大きな文字では欧文の字間が開きすぎるので、本文より詰める。 */
    letter-spacing: 0.03em;
  }

  .neighbors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    max-width: var(--measure);
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .neighbors a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }

  .newer {
    grid-column: 2;
    text-align: right;
  }

  .label {
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .neighbor-title {
    color: var(--strong);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.8;
    word-break: auto-phrase;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.2s;
  }

  .neighbors a:hover .neighbor-title {
    text-decoration-color: currentColor;
  }

  @media (width < 36rem) {
    .neighbors {
      grid-template-columns: 1fr;
    }

    .newer {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
