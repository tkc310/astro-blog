---
// 一覧の 2 ページ目以降（/articles/page/<n>）。1 ページ目はトップ。
import type { GetStaticPaths } from "astro";

import BoardTable from "../../../components/BoardTable.astro";
import Pager from "../../../components/Pager.astro";
import Base from "../../../layouts/Base.astro";
import { slicePage } from "../../../lib/board";
import { getPostNumbers, getPosts } from "../../../lib/posts";
import { site } from "../../../site.config";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const { totalPages } = slicePage(posts, 1, site.perPage);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}) satisfies GetStaticPaths;

const page = Number(Astro.params.page);
const posts = await getPosts();
const numbers = await getPostNumbers();
const slice = slicePage(posts, page, site.perPage);
---

<Base title={`書き込みの一覧（${slice.page} ページ目）`}>
  <h1>書き込みの一覧（{slice.page} ページ目）</h1>
  <BoardTable posts={slice.items} numbers={numbers} caption={`書き込みの一覧 ${slice.page} ページ目`} />
  <Pager page={slice.page} totalPages={slice.totalPages} perPage={site.perPage} />
</Base>
