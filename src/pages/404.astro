---
import PageHeader from "../components/PageHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex>
  <PageHeader title="404" lead="お探しのページは見つかりませんでした。移動したか、削除された可能性があります。" />
  <p class="links">
    <a href="/">記事の一覧へ</a>
    <a href="/about">私について</a>
  </p>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
  }
</style>
