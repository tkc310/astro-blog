---
// トップ（/）: 私について。自己紹介と、LAPRAS の活動一覧（ADR-0017）。記事の一覧は置かない。
// 旧ブログの /about へのリンクは、public/_redirects でここへ 301 する（docs/specs/design.md §5）。
//
// このページだけをリクエストのときにサーバ（Worker）で描画する。LAPRAS の API はブラウザから
// 呼ぶと CORS で止まるため。開発中（make dev）は毎回描画し、本番は Cloudflare のキャッシュに置いて
// 期限が切れたら裏で描き直す（ISR と同じ動き）。
import PageHeader from "../components/PageHeader.astro";
import { fetchActivities, formatActivityDate, laprasProfileUrl, TYPE_LABELS } from "../lib/lapras";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

export const prerender = false;

/** 取れたときのキャッシュ: 1 時間は新しいとみなし、その後 1 日は古いものを返しながら描き直す。 */
const CACHE_OK = { maxAge: 60 * 60, swr: 60 * 60 * 24 };
/** 取れなかったときのキャッシュ: 5 分で取り直す（LAPRAS に何度も行かないように）。 */
const CACHE_FAILED = { maxAge: 60 * 5 };

const { author } = site;
const laprasProfile = laprasProfileUrl(author.accounts.lapras);
const activities = await fetchActivities(author.accounts.lapras, { limit: 10 });

// cache.enabled は開発中とキャッシュの設定が無いときは false（毎回描画する）。
if (Astro.cache.enabled) {
  Astro.cache.set({ ...(activities.ok ? CACHE_OK : CACHE_FAILED), tags: ["lapras"] });
}
---

<Base title="私について" description={`${author.name} の自己紹介と、最近の活動`}>
  <PageHeader title={author.name}>
    <p class="intro">{author.description}</p>
  </PageHeader>

  <section class="activity" aria-labelledby="activity-heading">
    <h2 id="activity-heading">最近の活動</h2>
    <p class="note">
      <a href={laprasProfile} target="_blank" rel="noopener">LAPRAS</a> に集まった GitHub・Zenn・Qiita などの記録です。
    </p>
    {
      !activities.ok ? (
        <p class="status">
          活動を読み込めませんでした。
          <a href={laprasProfile} target="_blank" rel="noopener">
            LAPRAS のプロフィールを見る
          </a>
        </p>
      ) : activities.activities.length === 0 ? (
        <p class="status">まだ活動の記録はありません。</p>
      ) : (
        <>
          <ol class="list">
            {activities.activities.map((activity) => (
              <li>
                <time datetime={activity.date}>{formatActivityDate(activity.date)}</time>
                <div>
                  <a href={activity.url} target="_blank" rel="noopener">
                    {activity.title}
                  </a>
                  <span class="type">{TYPE_LABELS[activity.type] ?? activity.type}</span>
                </div>
              </li>
            ))}
          </ol>
          <p class="more">
            <a href={laprasProfile} target="_blank" rel="noopener">
              LAPRAS ですべての活動を見る
            </a>
          </p>
        </>
      )
    }
  </section>
</Base>

<style>
  .intro {
    max-width: var(--measure);
    margin: var(--space-6) 0 0;
    color: var(--ink);
    font-size: var(--text-md);
    line-height: 2.1;
  }

  h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
  }

  .note {
    margin: 0 0 var(--space-7);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .status {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: grid;
    grid-template-columns: var(--date-column) minmax(0, 1fr);
    gap: 0 var(--space-5);
  }

  .list li + li {
    margin-top: var(--space-5);
  }

  .list time {
    padding-top: 0.2em;
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .list a {
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.9;
    word-break: auto-phrase;
    text-decoration-color: transparent;
  }

  .list a:hover {
    color: var(--strong);
    text-decoration-color: currentColor;
  }

  .type {
    display: block;
    color: var(--muted);
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
  }

  .more {
    margin: var(--space-7) 0 0;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  @media (width < 36rem) {
    .list li {
      grid-template-columns: minmax(0, 1fr);
    }

    .list time {
      padding-top: 0;
    }
  }
</style>
