---
// トップ: サイトの紹介、カテゴリへのリンク、年でまとめた記事の一覧（docs/specs/design.md §5）。
import CategoryLabel from "../components/CategoryLabel.astro";
import Pager from "../components/Pager.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { slicePage } from "../lib/listing";
import { getCategories, getPosts } from "../lib/posts";
import { site } from "../site.config";

const posts = await getPosts();
const categories = await getCategories();
const { items, page, totalPages } = slicePage(posts, 1, site.perPage);
---

<Base>
  <section class="intro">
    <h1 class="visually-hidden">{site.name}</h1>
    <p class="lead">{site.description}。</p>
    {
      categories.length > 0 && (
        <nav aria-label="カテゴリ">
          <ul class="categories">
            {categories.map((category) => (
              <li>
                <CategoryLabel category={category} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </section>

  <PostList posts={items} />
  <Pager page={page} totalPages={totalPages} />
</Base>

<style>
  .intro {
    margin-bottom: 4rem;
  }

  .lead {
    margin: 0 0 1rem;
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
