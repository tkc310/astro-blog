---
import Base from "../layouts/Base.astro";
import { articlePath, getPosts } from "../lib/posts";

const posts = await getPosts();
---

<Base>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={articlePath(post.id)}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</Base>
