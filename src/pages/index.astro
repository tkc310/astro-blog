---
// トップ（/）: 記事の一覧。カテゴリへのリンクと、新しい順の記事（docs/specs/design.md §5）。
// 2 ページ目からは /articles/page/<n>。/articles はここへ 301。
import CategoryLabel from "../components/CategoryLabel.astro";
import PageHeader from "../components/PageHeader.astro";
import Pager from "../components/Pager.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { slicePage } from "../lib/listing";
import { getCategories, getPosts } from "../lib/posts";
import { site } from "../site.config";

const posts = await getPosts();
const categories = await getCategories();
const { items, page, totalPages } = slicePage(posts, 1, site.perPage);
---

<Base title="記事" description={`${site.description}の記事の一覧`}>
  <PageHeader title="記事">
    {
      categories.length > 0 && (
        <nav aria-label="カテゴリ">
          <ul class="categories">
            {categories.map((category) => (
              <li>
                <CategoryLabel category={category} />
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </PageHeader>

  <PostList posts={items} />
  <Pager page={page} totalPages={totalPages} />
</Base>

<style>
  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
