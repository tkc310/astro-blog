---
// トップ（/）: 自己紹介。最近の記事と、LAPRAS の活動一覧（ADR-0017）。
// /about は public/_redirects でここへ 301 する（docs/specs/design.md §5）。
//
// このページだけをリクエストのときにサーバ（Worker）で描画する。LAPRAS の API はブラウザから
// 呼ぶと CORS で止まるため。開発中（make dev）は毎回描画し、本番は Cloudflare のキャッシュに置いて
// 期限が切れたら裏で描き直す（ISR と同じ動き）。
import { formatDate, toIsoDate } from "../lib/format";
import { fetchActivities, formatActivityDate, laprasProfileUrl, TYPE_LABELS } from "../lib/lapras";
import { articlePath, getPosts } from "../lib/posts";
import Base from "../layouts/Base.astro";
import { site } from "../site.config";

export const prerender = false;

/** 取れたときのキャッシュ: 1 時間は新しいとみなし、その後 1 日は古いものを返しながら描き直す。 */
const CACHE_OK = { maxAge: 60 * 60, swr: 60 * 60 * 24 };
/** 取れなかったときのキャッシュ: 5 分で取り直す（LAPRAS に何度も行かないように）。 */
const CACHE_FAILED = { maxAge: 60 * 5 };

const { author } = site;
const laprasProfile = laprasProfileUrl(author.accounts.lapras);
const recent = (await getPosts()).slice(0, 3);
const activities = await fetchActivities(author.accounts.lapras, { limit: 10 });

// cache.enabled は開発中とキャッシュの設定が無いときは false（毎回描画する）。
if (Astro.cache.enabled) {
  Astro.cache.set({ ...(activities.ok ? CACHE_OK : CACHE_FAILED), tags: ["lapras"] });
}
---

<Base description={`${author.name} の自己紹介と、${site.description}`}>
  <h1>{author.name}</h1>
  <p class="intro">{author.description}</p>

  <section class="recent" aria-labelledby="recent-heading">
    <h2 id="recent-heading">最近の記事</h2>
    <ol class="recent-list">
      {
        recent.map((post) => (
          <li>
            <time datetime={toIsoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
            <a href={articlePath(post.id)}>{post.data.title}</a>
          </li>
        ))
      }
    </ol>
    <p class="more"><a href="/articles">記事の一覧へ</a></p>
  </section>

  <section class="activity" aria-labelledby="activity-heading">
    <h2 id="activity-heading">最近の活動</h2>
    <p class="note">
      <a href={laprasProfile} target="_blank" rel="noopener">LAPRAS</a> に集まった GitHub・Zenn・Qiita などの記録です。
    </p>
    {
      !activities.ok ? (
        <p class="status">
          活動を読み込めませんでした。
          <a href={laprasProfile} target="_blank" rel="noopener">
            LAPRAS のプロフィールを見る
          </a>
        </p>
      ) : activities.activities.length === 0 ? (
        <p class="status">まだ活動の記録はありません。</p>
      ) : (
        <>
          <ol class="list">
            {activities.activities.map((activity) => (
              <li>
                <time datetime={activity.date}>{formatActivityDate(activity.date)}</time>
                <a href={activity.url} target="_blank" rel="noopener">
                  {activity.title}
                </a>
                <span class="type">{TYPE_LABELS[activity.type] ?? activity.type}</span>
              </li>
            ))}
          </ol>
          <p class="more">
            <a href={laprasProfile} target="_blank" rel="noopener">
              LAPRAS ですべての活動を見る
            </a>
          </p>
        </>
      )
    }
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 0.75rem;
    font-size: 2rem;
  }

  .intro {
    max-width: var(--measure);
    margin: 0 0 4.5rem;
    font-size: 1.05rem;
  }

  section + section {
    margin-top: 4.5rem;
  }

  .recent-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-list li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }

  .recent-list time {
    color: var(--muted);
    font-size: 0.94rem;
  }

  .recent-list a {
    color: var(--strong);
    text-decoration: none;
    word-break: auto-phrase;
  }

  .recent-list a:hover {
    text-decoration: underline;
  }

  .more {
    margin: 1rem 0 0;
    font-size: 0.94rem;
  }

  @media (width < 36rem) {
    .recent-list li {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  h2 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }

  .note {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .status {
    margin: 0;
    color: var(--muted);
  }

  .list {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    gap: 0 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.94rem;
  }

  .list time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .list a {
    word-break: auto-phrase;
  }

  .list .type {
    font-size: 0.82rem;
    color: var(--muted);
  }

  @media (width < 36rem) {
    .list li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .list a {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
