---
// フッター: 各 SNS へのリンクと著作権表示（docs/specs/design.md §4）。
import { site } from "../site.config";

const since = 2021;
const year = new Date().getFullYear();
const { accounts } = site.author;
const profiles = [
  { href: `https://github.com/${accounts.github}`, label: "GitHub" },
  { href: `https://x.com/${accounts.x}`, label: "X" },
  { href: `https://zenn.dev/${accounts.zenn}`, label: "Zenn" },
  { href: `https://qiita.com/${accounts.qiita}`, label: "Qiita" },
  { href: `https://lapras.com/public/${accounts.lapras}`, label: "LAPRAS" },
];
---

<footer class="footer">
  <ul class="profiles">
    {
      profiles.map((profile) => (
        <li>
          <a href={profile.href} rel="me noopener" target="_blank">
            {profile.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="copyright"><small>© {since}–{year} {site.author.name}</small></p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-10);
    padding: var(--space-6) 0 var(--space-8);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profiles a {
    color: var(--muted);
    text-decoration-color: transparent;
  }

  .profiles a:hover {
    color: var(--strong);
    text-decoration-color: currentColor;
  }

  .copyright {
    margin: 0;
  }

  .copyright small {
    font-size: inherit;
  }

  @media (width < 36rem) {
    .footer {
      margin-top: var(--space-9);
    }
  }

  @media print {
    .profiles {
      display: none;
    }
  }
</style>
