---
// フッター: 各 SNS へのリンクと著作権表示（docs/specs/design.md §4）。
import { site } from "../site.config";

const since = 2021;
const year = new Date().getFullYear();
const { accounts } = site.author;
const profiles = [
  { href: `https://github.com/${accounts.github}`, label: "GitHub" },
  { href: `https://x.com/${accounts.x}`, label: "X" },
  { href: `https://zenn.dev/${accounts.zenn}`, label: "Zenn" },
  { href: `https://qiita.com/${accounts.qiita}`, label: "Qiita" },
  { href: `https://lapras.com/public/${accounts.lapras}`, label: "LAPRAS" },
];
---

<footer class="footer">
  <ul class="profiles">
    {
      profiles.map((profile) => (
        <li>
          <a href={profile.href} rel="me noopener" target="_blank">
            {profile.label}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="copyright"><small>© {since}–{year} {site.author.name}</small></p>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 6rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.88rem;
    color: var(--muted);
  }

  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profiles a {
    color: var(--muted);
    text-decoration: none;
  }

  .profiles a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .copyright {
    margin: 0;
  }

  @media print {
    .profiles {
      display: none;
    }
  }
</style>
