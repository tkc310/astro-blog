---
// ヘッダー: 左にサイト名、右に「私について」「記事」（docs/specs/design.md §4）。
import { site } from "../site.config";

// build.format: 'file' では /articles.html・/index.html の形で来るので、拡張子と index を外してそろえる。
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
// トップ（/）は自己紹介（/about からも 301 で来る）、記事は /articles の下（docs/specs/design.md §5）。
const links = [
  { href: "/", label: "私について", current: path === "/" },
  { href: "/articles", label: "記事", current: path.startsWith("/articles") },
];
---

<header class="header">
  <a class="name" href="/">{site.name}</a>
  <nav aria-label="サイト">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-7);
  }

  .name {
    color: var(--strong);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
  }

  nav a {
    color: var(--muted);
    text-decoration-color: transparent;
    text-underline-offset: 0.6em;
  }

  nav a:hover {
    color: var(--strong);
  }

  nav a[aria-current="page"] {
    color: var(--strong);
    text-decoration-color: currentColor;
  }

  @media (width < 36rem) {
    .header {
      padding-top: var(--space-6);
    }

    ul {
      gap: var(--space-5);
    }
  }

  @media print {
    nav {
      display: none;
    }
  }
</style>
