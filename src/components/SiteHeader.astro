---
// ヘッダー: 左にサイト名、右に「記事」「About」（docs/specs/design.md §4）。
import { site } from "../site.config";

// build.format: 'file' では /about.html・/index.html の形で来るので、拡張子と index を外してそろえる。
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const isArticles = path === "/" || path.startsWith("/articles");
const links = [
  { href: "/", label: "記事", current: isArticles },
  { href: "/about", label: "About", current: path === "/about" },
];
---

<header class="header">
  <a class="name" href="/">{site.name}</a>
  <nav aria-label="サイト">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.current ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 0;
  }

  .name {
    color: var(--ink);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.94rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  @media print {
    nav {
      display: none;
    }
  }
</style>
