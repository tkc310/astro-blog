---
// アクセスカウンターの見た目で、記事数を出す。数えていないアクセス数は出さない（ADR-0013）。
import { toCounterDigits } from "../lib/format";

interface Props {
  value: number;
  label: string;
}

const { value, label } = Astro.props;
const digits = toCounterDigits(value);
---

<span class="counter" role="img" aria-label={`${label} ${value}`}>
  {digits.split("").map((digit) => <span class="digit">{digit}</span>)}
</span>

<style>
  .counter {
    display: inline-flex;
    gap: 1px;
    padding: 2px;
    background: var(--counter-bg);
    border: 2px inset var(--frame-hi);
    vertical-align: middle;
  }

  .digit {
    display: inline-block;
    min-width: 1ch;
    padding: 0 0.15em;
    font-family: var(--mono);
    font-weight: bold;
    line-height: 1.4;
    color: var(--counter-ink);
    background: #111111;
  }
</style>
