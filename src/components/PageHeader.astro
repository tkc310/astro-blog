---
// ページの題（記事・カテゴリ・私について・404）。大きく細い文字を、字間を広く取って置く。
// このサイトでいちばん目立つ要素で、ほかは小さく静かに組む（docs/specs/design.md §2）。
interface Props {
  title: string;
  /** 題の上に置く小さな補足（例: カテゴリ）。 */
  kicker?: string;
  /** 題の下の説明。 */
  lead?: string;
}

const { title, kicker, lead } = Astro.props;
---

<header class="page-header">
  <slot name="before" />
  {kicker && <p class="kicker">{kicker}</p>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-header {
    margin-bottom: var(--space-9);
  }

  .kicker {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 200;
    line-height: 1.3;
    letter-spacing: 0.16em;
  }

  .lead {
    max-width: var(--measure);
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 2.1;
  }

  .page-header > :global(nav) {
    margin-top: var(--space-6);
  }

  @media (width < 36rem) {
    .page-header {
      margin-bottom: var(--space-8);
    }
  }
</style>
