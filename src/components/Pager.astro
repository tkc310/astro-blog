---
// ページ送り: [1] [2] [3] 次の10件>>（docs/specs/design.md §4）。
import { listPageHref } from "../lib/board";

interface Props {
  page: number;
  totalPages: number;
  perPage: number;
}

const { page, totalPages, perPage } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="ページ送り">
      {page > 1 && <a href={listPageHref(page - 1)}>&lt;&lt;前の{perPage}件</a>}
      {pages.map((n) =>
        n === page ? (
          <strong aria-current="page">{n}</strong>
        ) : (
          <a href={listPageHref(n)}>[{n}]</a>
        ),
      )}
      {page < totalPages && <a href={listPageHref(page + 1)}>次の{perPage}件&gt;&gt;</a>}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 0.8em;
    margin: 1em 0;
    font-family: var(--mono);
  }
</style>
