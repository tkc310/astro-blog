---
// ページ送り: 前へ / 1 2 3 / 次へ（docs/specs/design.md §4）。
import { listPageHref } from "../lib/listing";

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

{
  totalPages > 1 && (
    <nav class="pager" aria-label="ページ送り">
      {page > 1 ? <a href={listPageHref(page - 1)} rel="prev">前へ</a> : <span class="off">前へ</span>}
      <ol>
        {pages.map((n) => (
          <li>
            {n === page ? (
              <span class="current numeric" aria-current="page">{n}</span>
            ) : (
              <a class="numeric" href={listPageHref(n)}>{n}</a>
            )}
          </li>
        ))}
      </ol>
      {page < totalPages ? <a href={listPageHref(page + 1)} rel="next">次へ</a> : <span class="off">次へ</span>}
    </nav>
  )
}

<style>
  .pager {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    margin-top: var(--space-9);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
  }

  ol {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--muted);
    text-decoration-color: transparent;
  }

  a:hover {
    color: var(--strong);
    text-decoration-color: currentColor;
  }

  .current {
    color: var(--strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .off {
    color: var(--faint);
  }
</style>
