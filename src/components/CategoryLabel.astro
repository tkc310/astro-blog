---
// カテゴリ: 小さな丸（カテゴリの色）＋名前。色は旧ブログの色の名前を、落ち着いた色に置き換える。
import type { CategoryColor } from "../lib/category-colors";
import { categoryPath, type Category } from "../lib/posts";

interface Props {
  category: Category;
  link?: boolean;
}

const { category, link = true } = Astro.props;

const palette: Record<CategoryColor, string> = {
  blue: "#3b6fd4",
  green: "#2f8a5b",
  red: "#c94a4a",
  pink: "#c75b8f",
  orange: "#d07a2d",
  yellow: "#b8961e",
  cyan: "#2a93a8",
  teal: "#24857a",
  purple: "#7a5bc2",
  black: "#3a3f45",
  gray: "#8a929b",
};
const color = palette[category.data.color];
---

{
  link ? (
    <a class="category" href={categoryPath(category.id)} style={`--dot: ${color}`}>
      {category.data.name}
    </a>
  ) : (
    <span class="category" style={`--dot: ${color}`}>
      {category.data.name}
    </span>
  )
}

<style>
  .category {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--muted);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 0.2s;
  }

  .category::before {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--dot);
    flex: none;
  }

  a.category:hover {
    color: var(--strong);
  }
</style>
