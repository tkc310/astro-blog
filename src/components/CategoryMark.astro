---
// カテゴリの「■」。色は旧ブログのカテゴリの色を、四角にだけ付ける（docs/specs/design.md）。
import type { Category } from "../lib/posts";

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<span class="mark" style={`--category: ${category.data.color}`} aria-hidden="true">■</span>

<style>
  .mark {
    color: var(--category);
    margin-right: 0.15em;
  }

  @media (prefers-color-scheme: dark) {
    .mark {
      color: var(--ink);
    }
  }
</style>
