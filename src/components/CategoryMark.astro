---
// カテゴリの「■」。色は旧ブログのカテゴリの色を、四角にだけ付ける（docs/specs/design.md）。
import type { Category } from "../lib/posts";

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<span class="mark" style={`--category: ${category.data.color}`} aria-hidden="true">■</span>

<style>
  /* 昼はカテゴリの色。夜は --mark（文字と同じ緑）を使う（src/styles/global.css）。 */
  .mark {
    color: var(--mark, var(--category));
    margin-right: 0.15em;
  }
</style>
