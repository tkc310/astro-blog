---
// 記事の一覧。新しい順に 1 本ずつ、日付（2026.10.19）・題名・説明・カテゴリを並べる（docs/specs/design.md §4）。
// 線や枠で区切らず、行のあいだの余白だけで分ける。
import { formatDate, toIsoDate } from "../lib/format";
import { articlePath, getCategory, type Post } from "../lib/posts";
import CategoryLabel from "./CategoryLabel.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const categories = new Map(
  await Promise.all(posts.map(async (post) => [post.id, await getCategory(post)] as const)),
);
---

{
  posts.length === 0 ? (
    <p class="empty">まだ記事はありません。</p>
  ) : (
    <ol class="posts">
      {posts.map((post) => {
        const category = categories.get(post.id);
        return (
          <li class="post">
            <time class="date" datetime={toIsoDate(post.data.pubDate)}>
              {formatDate(post.data.pubDate)}
            </time>
            <div class="body">
              <h2 class="title">
                <a href={articlePath(post.id)} style={`view-transition-name: post-${post.id}`}>
                  {post.data.title}
                </a>
                {post.data.draft && <span class="draft">下書き</span>}
              </h2>
              <p class="description">{post.data.description}</p>
              {category && <CategoryLabel category={category} />}
            </div>
          </li>
        );
      })}
    </ol>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post {
    display: grid;
    grid-template-columns: var(--date-column) minmax(0, 1fr);
    gap: 0 var(--space-5);
  }

  .post + .post {
    margin-top: var(--space-7);
  }

  .date {
    /* 題名の 1 行目と文字の下端をそろえる。 */
    padding-top: 0.32em;
    color: var(--muted);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
  }

  .title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 600;
    line-height: 1.75;
    letter-spacing: 0.06em;
  }

  .title a {
    color: var(--strong);
    text-decoration-color: transparent;
  }

  .title a:hover {
    text-decoration-color: currentColor;
  }

  .draft {
    margin-left: 0.75em;
    padding: 0.1em 0.6em;
    border: 1px solid var(--faint);
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--text-2xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    vertical-align: 0.15em;
  }

  .description {
    margin: var(--space-2) 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.95;
  }

  .empty {
    color: var(--muted);
  }

  @media (width < 36rem) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }

    .date {
      padding-top: 0;
      font-size: var(--text-xs);
    }
  }
</style>
