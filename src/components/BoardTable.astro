---
// 掲示板の表（No.・題名・カテゴリ・投稿日）。docs/specs/design.md §4。
import { formatBbsDate, isNew, toIsoDate } from "../lib/format";
import { articlePath, getCategory, type Post } from "../lib/posts";
import CategoryMark from "./CategoryMark.astro";

interface Props {
  posts: Post[];
  numbers: Map<string, number>;
  caption: string;
}

const { posts, numbers, caption } = Astro.props;
const now = new Date();
const rows = await Promise.all(
  posts.map(async (post) => ({ post, category: await getCategory(post), number: numbers.get(post.id) })),
);
---

{
  rows.length === 0 ? (
    <p>まだ書き込みはありません。</p>
  ) : (
    <table class="bevel board">
      <caption class="visually-hidden">{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="no">No.</th>
          <th scope="col">題名</th>
          <th scope="col" class="category">カテゴリ</th>
          <th scope="col" class="date">投稿日</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ post, category, number }) => (
          <tr>
            <td class="no">{number ?? "下書き"}</td>
            <th scope="row" class="subject">
              <a href={articlePath(post.id)} style={`view-transition-name: post-${post.id}`}>
                {post.data.title}
              </a>
              {isNew(post.data.pubDate, now) && <span class="new">NEW!</span>}
            </th>
            <td class="category">
              <CategoryMark category={category} />
              {category.data.name}
            </td>
            <td class="date">
              <time datetime={toIsoDate(post.data.pubDate)}>{formatBbsDate(post.data.pubDate)}</time>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}

<style>
  .board {
    width: 100%;
    max-width: 48em;
  }

  .board thead th {
    text-align: left;
    white-space: nowrap;
  }

  .no {
    font-family: var(--mono);
    text-align: right;
    white-space: nowrap;
    width: 3.5em;
  }

  .subject {
    font-weight: normal;
    text-align: left;
  }

  .category,
  .date {
    white-space: nowrap;
    font-size: 0.9em;
  }

  .date {
    font-family: var(--mono);
  }

  .new {
    margin-left: 0.4em;
    font-family: var(--mono);
    font-size: 0.8em;
    font-weight: bold;
    color: var(--alert);
    animation: blink 1s steps(2, start) infinite;
  }

  @keyframes blink {
    to {
      visibility: hidden;
    }
  }

  /* スマホでは 1 件ずつの段組みにする。 */
  @media (width < 40em) {
    .board,
    .board tbody,
    .board tr,
    .board th,
    .board td {
      display: block;
      width: auto;
    }

    .board thead {
      display: none;
    }

    .board tr {
      border: 1px var(--bevel-in) var(--frame-hi);
      margin-bottom: 0.4em;
      padding: 0.3em 0.5em;
    }

    .board td,
    .board th {
      border: none;
      padding: 0;
    }

    .no {
      text-align: left;
    }

    .no::before {
      content: "No.";
    }

    .category,
    .date {
      display: inline-block;
      margin-right: 1em;
    }
  }
</style>
