---
// 目次。h2・h3 から作る。PC は本文の横に固定、スマホは本文の前に畳む（docs/specs/design.md §4）。
// 現在位置の強調だけ小さなスクリプトで行う（rules/architecture.md で許したクライアント JS）。
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
  items.length > 0 && (
    <details class="toc" open data-toc>
      <summary>目次</summary>
      <ol>
        {items.map((heading) => (
          <li class={`depth-${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<script>
  // 画面に入っている見出しに対応する目次の項目へ aria-current を付ける。
  const toc = document.querySelector<HTMLElement>("[data-toc]");
  if (toc && "IntersectionObserver" in window) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")) {
      links.set(decodeURIComponent(link.hash.slice(1)), link);
    }
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        const target = visible[0]?.target;
        if (!target) return;
        for (const link of links.values()) link.removeAttribute("aria-current");
        links.get(target.id)?.setAttribute("aria-current", "true");
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    for (const id of links.keys()) {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    }
  }
</script>

<style>
  .toc {
    margin: 0 0 var(--space-7);
    font-size: var(--text-xs);
    line-height: 1.7;
    letter-spacing: 0.05em;
  }

  summary {
    color: var(--strong);
    font-weight: 600;
    letter-spacing: 0.12em;
    cursor: pointer;
  }

  ol {
    margin: var(--space-3) 0 0;
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  li + li {
    margin-top: var(--space-2);
  }

  .depth-3 {
    padding-left: var(--space-4);
  }

  a {
    display: block;
    color: var(--muted);
    text-decoration: none;
  }

  a:hover,
  [aria-current] {
    color: var(--strong);
  }

  /* 今読んでいる見出しは、左の線に黒い印を重ねて示す。 */
  [aria-current] {
    position: relative;
  }

  [aria-current]::before {
    content: "";
    position: absolute;
    inset: 0.15em auto 0.15em calc(var(--space-4) * -1 - 1px);
    width: 1px;
    background: var(--strong);
  }

  .depth-3 [aria-current]::before {
    left: calc(var(--space-4) * -2 - 1px);
  }

  @media (width >= 80rem) {
    .toc {
      margin: 0;
    }

    summary {
      pointer-events: none;
      list-style: none;
    }

    summary::-webkit-details-marker {
      display: none;
    }
  }
</style>
