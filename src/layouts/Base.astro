---
// 全ページの枠。中央の 1 列に、ヘッダー・本文・フッターを置く（docs/specs/design.md §3）。
// メタタグと構造化データは SEO の PR で足す（docs/specs/blog-replace.md の「進め方」4）。
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
}

// どのページも同じ幅の 1 列にし、ページを移ってもヘッダーと本文の左端が動かないようにする。
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

// 同じサイトのページを、リンクにカーソルを載せた時点で先読みする（ADR-0016）。JS は実行しない。
const speculationRules = {
  prerender: [
    {
      where: {
        and: [{ href_matches: "/*" }, { not: { href_matches: "/admin/*" } }],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <div class="page">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .page {
    max-width: calc(var(--column) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  main {
    padding-top: var(--space-10);
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: var(--space-4);
    top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    background: var(--paper);
    border: 1px solid var(--line);
    z-index: 1;
  }

  @media (width < 36rem) {
    main {
      padding-top: var(--space-8);
    }
  }
</style>
