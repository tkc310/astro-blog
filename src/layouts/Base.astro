---
// 全ページの枠。中央の 1 列に、ヘッダー・本文・フッターを置く（docs/specs/design.md §3）。
// メタタグと構造化データは SEO の PR で足す（docs/specs/blog-replace.md の「進め方」4）。
import "../styles/global.css";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  /** 記事のページは、本文の右に目次を置くため列を広げる。 */
  wide?: boolean;
}

const { title, description = site.description, wide = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;

// 同じサイトのページを、リンクにカーソルを載せた時点で先読みする（ADR-0016）。JS は実行しない。
const speculationRules = {
  prerender: [
    {
      where: {
        and: [{ href_matches: "/*" }, { not: { href_matches: "/admin/*" } }],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <div class:list={["page", { wide }]}>
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  .page {
    max-width: calc(var(--column) + var(--gutter) * 2);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .page.wide {
    max-width: calc(62rem + var(--gutter) * 2);
  }

  main {
    padding-top: 4rem;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    padding: 0.4rem 0.8rem;
    background: var(--paper);
    border: 1px solid var(--line);
    z-index: 1;
  }

  @media (width < 36rem) {
    main {
      padding-top: 2.5rem;
    }
  }
</style>
